generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id  String @id @default(uuid())
  google_id String @unique
  email String @unique
  name String 
  picture String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}