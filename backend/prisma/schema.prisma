generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id  String @id @default(uuid())
  google_id String @unique
  email String @unique
  name String 
  picture String
  isPrivate Boolean @default(false)
  username String? @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  post Post[]
  story Story[]
  reel Reel[]
  comments Comment[]
  commentLikes CommentLike[]

  followers Follow[] @relation("Followers")
  following Follow[] @relation("Following")

  sentMessages Message[] @relation("UserSentMessages")
  receivedMessages Message[] @relation("UserReceivedMessages")
}

model Follow{
  id String @id @default(uuid())

  followerId String
  followingId String

  @@unique([followerId, followingId]) //when combined these always should be unique

  follower User @relation("Followers", fields: [followerId], references: [id])
  following User @relation("Following", fields: [followingId], references: [id])

  createdAt DateTime @default(now())
}

model Post{
  id String @id @default(uuid())
  fileUrl String
  fileType String?
  userId String 
  type String @default("POST")
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  comments Comment[]
}

model Story{
  id String @id @default(uuid())
  fileUrl String
  fileType String?
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Reel{
  id String @id @default(uuid())
  fileUrl String
  fileType String?
  userId String
  type String @default("REEL")
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  comments Comment[]
}

model Comment{
  id String @id @default(uuid())
  content String
  postId String?
  reelId String?
  userId String
  parentId String? //if null its top level comment

  createdAt DateTime @default(now())

  post Post? @relation(fields: [postId], references: [id])
  reel Reel? @relation(fields: [reelId], references: [id])
  user User @relation(fields: [userId], references: [id])
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  commentLikes CommentLike[]
} 

model CommentLike{
  id String @id @default(uuid())
  userId String
  commentId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])

  @@unique([userId, commentId]) //prevent double likes
}

model Message{
  id String @id @default(uuid())
  senderId String
  sender User @relation("UserSentMessages", fields: [senderId], references: [id])

  receiverId String
  receiver User @relation("UserReceivedMessages", fields: [receiverId], references: [id])

  content String
  createdAt DateTime @default(now())
  read Boolean @default(false)
}